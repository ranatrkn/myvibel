            && sosyalVilHarcaniyor(3))
          || (isOwner(userId)
            && changedOnly(['puan', 'robot'])
            && intChangedBy('puan', -5)
            && takipGeriAlOdulOk(userId)
            && sosyalVilHarcaniyor(3))
          || (isOwner(userId)
            && changedOnly(['sonTakipOdulUid', 'robot'])
            && takipGeriAlOdulOk(userId)
            && sosyalVilHarcaniyor(3))
          || (isOwner(userId)
            && changedOnly(['robot'])
            && takipGeriAlOdulOk(userId)
            && sosyalVilHarcaniyor(3))
          || ownerBegeniUnlikeSyncOk(userId)
        );
    }

    // -------------------------------------------------------------------------
    // Gönderi doğrulama
    // -------------------------------------------------------------------------

    function postAlintiOk() {
      return !('alintiPostId' in request.resource.data)
        || (
          request.resource.data.alintiPostId is string
          && request.resource.data.alintiPostId.size() > 0
          && exists(/databases/$(database)/documents/posts/$(request.resource.data.alintiPostId))
          && get(/databases/$(database)/documents/posts/$(request.resource.data.alintiPostId)).data.ownerHesapGizli == false
          && get(/databases/$(database)/documents/posts/$(request.resource.data.alintiPostId)).data.raporNedeniyleGizli == false
          && ('alintiSnapshot' in request.resource.data)
          && request.resource.data.alintiSnapshot is map
          && request.resource.data.alintiSnapshot.postId == request.resource.data.alintiPostId
        );
    }

    function postCreateOk() {
      return emailVerified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.begeniSayisi == 0
        && request.resource.data.yorumSayisi == 0
        && request.resource.data.skor == 0
        && request.resource.data.sikayetSayisi == 0
        && request.resource.data.raporNedeniyleGizli == false
        && request.resource.data.ownerHesapGizli is bool
        && request.resource.data.metin is string
        && request.resource.data.metin.size() > 0
        && request.resource.data.metin.size() <= 10000
        && request.resource.data.kullaniciAdi is string
        && request.resource.data.kullaniciAdi.size() >= 1
        && (!('tags' in request.resource.data)
            || (request.resource.data.tags is list
                && request.resource.data.tags.size() <= 10))
        && (!('bahsetmeler' in request.resource.data)
            || (request.resource.data.bahsetmeler is list
                && request.resource.data.bahsetmeler.size() <= 10))
        && (!('mentionUidleri' in request.resource.data)
            || request.resource.data.mentionUidleri is map)
        && postAlintiOk();
    }

    function postSahibiUid(data) {
      return data.keys().hasAny(['userId']) && data.userId is string
        ? data.userId
        : '';
    }

    function ownerPostUpdateOk() {
      return changedOnly(['ownerHesapGizli', 'kullaniciAdi', 'avatarKey', 'photoUrl']);
    }

    function sabitGonderiMi(postId) {
      return postId == '';
    }

    function yorumPuanOncesiYok(postId, commentId) {
      return sabitGonderiMi(postId)
        ? !exists(/databases/$(database)/documents/sabitGonderiler/$(postId)/comments/$(commentId))
        : !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId));
    }

    function yorumPuanSonrasiBenim(postId, commentId, userId) {
      return sabitGonderiMi(postId)
        ? getAfter(/databases/$(database)/documents/sabitGonderiler/$(postId)/comments/$(commentId)).data.userId == userId
        : getAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.userId == userId;
    }

    function begeniKaydiVar(postId) {
      return sabitGonderiMi(postId)
        ? exists(/databases/$(database)/documents/sabitGonderiler/$(postId)/likes/$(request.auth.uid))
        : exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid));
    }

    function begeniKaydiVarSonra(postId) {
      return sabitGonderiMi(postId)
        ? existsAfter(/databases/$(database)/documents/sabitGonderiler/$(postId)/likes/$(request.auth.uid))
        : existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid));
    }

    function yorumKaydiVar(postId, commentId) {
      return sabitGonderiMi(postId)
        ? exists(/databases/$(database)/documents/sabitGonderiler/$(postId)/comments/$(commentId))
        : exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId));
    }

    function yorumKaydiVarSonra(postId, commentId) {
      return sabitGonderiMi(postId)
        ? existsAfter(/databases/$(database)/documents/sabitGonderiler/$(postId)/comments/$(commentId))
        : existsAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId));
    }

    function yorumSahibi(postId, commentId) {
      return sabitGonderiMi(postId)
        ? get(/databases/$(database)/documents/sabitGonderiler/$(postId)/comments/$(commentId)).data.userId
        : get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.userId;
    }

    function yorumSahibiSonra(postId, commentId) {
      return sabitGonderiMi(postId)
        ? getAfter(/databases/$(database)/documents/sabitGonderiler/$(postId)/comments/$(commentId)).data.userId
        : getAfter(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)).data.userId;
    }

    function postLikeIncrementOk(postId) {
      return changedOnly(['begeniSayisi', 'skor'])
        && intChangedBy('begeniSayisi', 1)
        && intChangedBy('skor', 3)
        && !begeniKaydiVar(postId)
        && begeniKaydiVarSonra(postId)
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId));
    }

    function postLikeDecrementOk(postId) {
      let hadLikedPost = exists(
        /databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId)
      );
      return changedOnly(['begeniSayisi', 'skor'])
        && intChangedBy('begeniSayisi', -1)
        && intChangedBy('skor', -3)
        && begeniKaydiVar(postId)
        && !begeniKaydiVarSonra(postId)
        && (
          !hadLikedPost
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId))
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId))
          )
        );
    }

    function postSelfLikeIncrementOk(postId) {
      return resource.data.userId == request.auth.uid
        && changedOnly(['begeniSayisi'])
        && intChangedBy('begeniSayisi', 1)
        && !begeniKaydiVar(postId)
        && begeniKaydiVarSonra(postId)
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId));
    }

    function postSelfLikeDecrementOk(postId) {
      let hadLikedPost = exists(
        /databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId)
      );
      return resource.data.userId == request.auth.uid
        && changedOnly(['begeniSayisi'])
        && intChangedBy('begeniSayisi', -1)
        && begeniKaydiVar(postId)
        && !begeniKaydiVarSonra(postId)
        && (
          !hadLikedPost
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId))
            && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId))
          )
        );
    }

    function postCommentIncrementOk(postId) {
      let commentId = request.resource.data.sonYorumId;
      return changedOnly(['yorumSayisi', 'skor', 'sonYorumId'])
        && commentId is string
        && commentId.size() > 0
        && intChangedBy('yorumSayisi', 1)
        && intChangedBy('skor', 5)
        && !yorumKaydiVar(postId, commentId)
        && yorumSahibiSonra(postId, commentId) == request.auth.uid;
    }

    function postCommentDecrementOk(postId) {
      let commentId = request.resource.data.sonYorumId;
      return changedOnly(['yorumSayisi', 'skor', 'sonYorumId'])
        && commentId is string
        && commentId.size() > 0
        && intChangedBy('yorumSayisi', -1)
        && intChangedBy('skor', -5)
        && yorumKaydiVar(postId, commentId)
        && !yorumKaydiVarSonra(postId, commentId)
        && yorumSahibi(postId, commentId) == request.auth.uid;
    }

    function postSelfCommentIncrementOk(postId) {
      let commentId = request.resource.data.sonYorumId;
      return resource.data.userId == request.auth.uid
        && changedOnly(['yorumSayisi', 'sonYorumId'])
        && commentId is string
        && commentId.size() > 0
        && intChangedBy('yorumSayisi', 1)
        && !yorumKaydiVar(postId, commentId)
        && yorumSahibiSonra(postId, commentId) == request.auth.uid;
    }

    function postSelfCommentDecrementOk(postId) {
      let commentId = request.resource.data.sonYorumId;
      return resource.data.userId == request.auth.uid
        && changedOnly(['yorumSayisi', 'sonYorumId'])
        && commentId is string
        && commentId.size() > 0
        && intChangedBy('yorumSayisi', -1)
        && yorumKaydiVar(postId, commentId)
        && !yorumKaydiVarSonra(postId, commentId)
        && yorumSahibi(postId, commentId) == request.auth.uid;
    }

    function postOwnerCommentRemoveOk(postId) {
      let commentId = request.resource.data.sonYorumId;
      return resource.data.userId == request.auth.uid
        && commentId is string
        && commentId.size() > 0
        && yorumKaydiVar(postId, commentId)
        && !yorumKaydiVarSonra(postId, commentId)
        && yorumSahibi(postId, commentId) != request.auth.uid
        && changedOnly(['yorumSayisi', 'skor', 'sonYorumId'])
        && intChangedBy('yorumSayisi', -1)
        && intChangedBy('skor', -5);
    }

    function postCommentThreadRemoveOk(postId) {
      let commentId = request.resource.data.sonYorumId;
      let n = intField(resource.data, 'yorumSayisi', 0)
          - intField(request.resource.data, 'yorumSayisi', 0);
      let skorDusus = intField(resource.data, 'skor', 0)
          - intField(request.resource.data, 'skor', 0);
      return commentId is string
        && commentId.size() > 0
        && n >= 1
        && n <= 40
        && skorDusus >= 0
        && skorDusus <= n * 5
        && skorDusus % 5 == 0
        && yorumKaydiVar(postId, commentId)
        && !yorumKaydiVarSonra(postId, commentId)
        && (
          yorumSahibi(postId, commentId) == request.auth.uid
          || resource.data.userId == request.auth.uid
        )
        && (
          (skorDusus == 0 && changedOnly(['yorumSayisi', 'sonYorumId']))
          || (skorDusus > 0 && changedOnly(['yorumSayisi', 'skor', 'sonYorumId']))
        );
    }

    function postCounterUpdateOk(postId) {
      return postLikeIncrementOk(postId)
        || postLikeDecrementOk(postId)
        || postSelfLikeIncrementOk(postId)
        || postSelfLikeDecrementOk(postId)
        || postCommentIncrementOk(postId)
        || postCommentDecrementOk(postId)
        || postSelfCommentIncrementOk(postId)
        || postSelfCommentDecrementOk(postId)
        || postOwnerCommentRemoveOk(postId)
        || postCommentThreadRemoveOk(postId);
    }

    function postReportUpdateOk(postId) {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let yeni = intField(request.resource.data, 'sikayetSayisi', 0);
      let eski = intField(resource.data, 'sikayetSayisi', 0);
      let reportId = 'post_' + request.auth.uid + '_' + postId;
      return diff.hasOnly(['sikayetSayisi', 'raporNedeniyleGizli', 'raporGuncellenmeTarihi'])
        && yeni == eski + 1
        && request.resource.data.raporNedeniyleGizli == (yeni >= 5)
        && !exists(/databases/$(database)/documents/reports/$(reportId))
        && existsAfter(/databases/$(database)/documents/reports/$(reportId));
    }

    function commentReportUpdateOk(postId, commentId) {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let yeni = intField(request.resource.data, 'sikayetSayisi', 0);
      let eski = intField(resource.data, 'sikayetSayisi', 0);
      let reportId = 'comment_' + request.auth.uid + '_' + postId + '_' + commentId;
      return diff.hasOnly(['sikayetSayisi', 'raporNedeniyleGizli', 'raporGuncellenmeTarihi'])
        && yeni == eski + 1
        && request.resource.data.raporNedeniyleGizli == (yeni >= 4)
        && !exists(/databases/$(database)/documents/reports/$(reportId))
        && existsAfter(/databases/$(database)/documents/reports/$(reportId));
    }

    function moderatorContentUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['raporNedeniyleGizli', 'raporGuncellenmeTarihi']);
    }

    // -------------------------------------------------------------------------
    // Bildirim / rapor doğrulama
    // -------------------------------------------------------------------------

    // Moderatörün destek yanıtı: yalnızca talebin sahibine, engelden bağımsız.
    function destekBildirimiOk(userId) {
      let ticketId = request.resource.data.get('ticketId', '');
      return request.resource.data.tip == 'destek'
        && isModerator()
        && ticketId is string
        && ticketId.size() > 0
        && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == userId
        && request.resource.data.okundu == false
        && request.resource.data.gonderenKullaniciAdi is string
        && request.resource.data.metin is string
        && request.resource.data.metin.size() <= 300;
    }

    function notificationCreateOk(userId) {
      return request.resource.data.gonderenUid == request.auth.uid
        && userId != request.auth.uid
        && (destekBildirimiOk(userId) || sosyalBildirimOk(userId));
    }

    function sosyalBildirimOk(userId) {
      return notBlockedPair(userId)
        && request.resource.data.tip in [
          'follow',
          'follow_request',
          'follow_accepted',
          'like',
          'comment',
          'comment_reply',
          'message',
          'mention',
          'maskot_yemek'
        ]
        && request.resource.data.okundu == false
        && request.resource.data.gonderenKullaniciAdi is string
        && request.resource.data.metin is string
        && request.resource.data.metin.size() <= 300
        && notificationTipKanitiOk(userId);
    }

    function notificationTipKanitiOk(userId) {
      let tip = request.resource.data.tip;
      let postId = request.resource.data.get('postId', '');
      let chatId = request.resource.data.get('chatId', '');
      return (tip == 'follow'
          && exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)))
        || (tip == 'follow_request'
          && exists(/databases/$(database)/documents/users/$(userId)/followRequests/$(request.auth.uid)))
        || (tip == 'follow_accepted'
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/followers/$(userId)))
        || (tip == 'like'
          && postId is string
          && postId.size() > 0
          && begeniKaydiVar(postId)
          && postOwner(postId) == userId)
        || ((tip == 'comment' || tip == 'comment_reply' || tip == 'mention')
          && postId is string
          && postId.size() > 0
          && (exists(/databases/$(database)/documents/posts/$(postId))
              || exists(/databases/$(database)/documents/sabitGonderiler/$(postId))))
        || (tip == 'message'
          && chatId is string
          && chatId.size() > 0
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && userId in get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
        || (tip == 'maskot_yemek'
          && (karsilikliTakipOk(request.auth.uid, userId)
            || exists(/databases/$(database)/documents/users/$(userId)/retyBaglari/$(request.auth.uid))));
    }

    function hesapSilmeGeriBildirimOk() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.neden is string
        && request.resource.data.neden.size() >= 2
        && request.resource.data.neden.size() <= 80
        && request.resource.data.digerMetin is string
        && request.resource.data.digerMetin.size() <= 400
        && request.resource.data.sorunMetin is string
        && request.resource.data.sorunMetin.size() <= 1000;
    }

    function reportCreateOk() {
      return emailVerified()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['post', 'comment', 'user']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 120;
    }

    function reportUpdateOk() {
      return request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.status in [
          'pending', 'reviewed', 'action_taken', 'rejected'
        ]
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt', 'reviewedBy']);
    }

    function supportTicketUpdateOk() {
      return isModerator()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.kategori == resource.data.kategori
        && request.resource.data.konu == resource.data.konu
        && request.resource.data.mesaj == resource.data.mesaj
        && request.resource.data.kullaniciAdi == resource.data.kullaniciAdi
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'modYaniti', 'yanitlandiAt'])
        && request.resource.data.status in [
          'pending', 'reviewed', 'resolved', 'rejected'
        ]
        && (!('modYaniti' in request.resource.data)
          || (request.resource.data.modYaniti is string
            && request.resource.data.modYaniti.size() <= 2000));
    }

    function supportTicketCreateOk() {
      return emailVerified()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kategori in ['hesap', 'hata', 'kvkk', 'yas_itiraz', 'oneri', 'diger']
        && request.resource.data.konu is string
        && request.resource.data.konu.size() >= 3
        && request.resource.data.konu.size() <= 120
        && request.resource.data.mesaj is string
        && request.resource.data.mesaj.size() >= 10
        && request.resource.data.mesaj.size() <= 2000
        && request.resource.data.kullaniciAdi is string
        && request.resource.data.kullaniciAdi.size() >= 1;
    }

    // -------------------------------------------------------------------------
    // Takip alt koleksiyon yardımcıları
    // -------------------------------------------------------------------------

    function followEdgeDataOk(followerUid) {
      return request.resource.data.keys().hasOnly(['userId', 'createdAt'])
        && request.resource.data.userId == followerUid;
    }

    function bekleyenTakipIstegiVar(hedefUid, istekciUid) {
      return exists(/databases/$(database)/documents/users/$(hedefUid)/followRequests/$(istekciUid));
    }

    function followRewardedDataOk(targetId) {
      return request.resource.data.targetUid == targetId
        && request.resource.data.keys().hasAll(['targetUid'])
        && request.resource.data.keys().hasOnly([
          'targetUid',
          'createdAt',
          'puanVerildi',
          'vilGeriAlindi'
        ])
        && request.resource.data.puanVerildi is bool
        && (
          !('vilGeriAlindi' in request.resource.data)
          || request.resource.data.vilGeriAlindi == false
        );
    }

    function followRewardedCreateOk(userId, targetId) {
      return followRewardedDataOk(targetId)
        && (
          (isOwner(userId) && request.resource.data.puanVerildi == true)
          || (request.auth.uid == targetId
            && request.resource.data.puanVerildi == false
            && bekleyenTakipIstegiVar(targetId, userId))
        );
    }

    function followingCreateOk(userId, targetId) {
      // userId = takip eden, targetId = takip edilen
      return followEdgeDataOk(userId)
        && notBlockedPair(request.auth.uid == userId ? targetId : userId)
        && (
          // Açık hesabı doğrudan takip et
          (isOwner(userId)
            && get(/databases/$(database)/documents/users/$(targetId)).data.hesapGizli != true)
          // Gizli hesap: kabul eden (targetId) yazıyor, istek kaydı mevcut
          || (isOwner(targetId)
            && bekleyenTakipIstegiVar(targetId, userId))
          // Onarım: kabul eden (targetId) yazıyor, karşı tarafta zaten followers kaydı var
          || (isOwner(targetId)
            && isFollower(userId, targetId))
          // Onarım: takip eden tekrar set ediyor, follower kaydı zaten var
          || (isOwner(userId)
            && isFollower(targetId, userId))
        );
    }

    function followerCreateOk(userId, followerId) {
      // userId = takip edilen, followerId = takip eden
      return followEdgeDataOk(followerId)
        && notBlockedPair(request.auth.uid == followerId ? userId : followerId)
        && (
          // Açık hesabı doğrudan takip et
          (request.auth.uid == followerId
            && get(/databases/$(database)/documents/users/$(userId)).data.hesapGizli != true)
          // Gizli hesap: hesap sahibi (userId) onaylıyor, istek mevcut
          || (isOwner(userId)
            && bekleyenTakipIstegiVar(userId, followerId))
          // Onarım: hesap sahibi yazıyor, karşı tarafta zaten following kaydı var
          || (isOwner(userId)
            && isFollowing(followerId, userId))
          // Onarım: takip eden tekrar set ediyor, following kaydı zaten var
          || (request.auth.uid == followerId
            && isFollowing(followerId, userId))
        );
    }

    // =========================================================================
    // Bekleyen kayıtlar — e-posta doğrulanmadan profil oluşmaz
    // =========================================================================

    function pendingProfileOk(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.kullaniciAdiKucuk is string
        && request.resource.data.kullaniciAdiKucuk.size() >= 3
        && request.resource.data.kullaniciAdiKucuk.size() <= 30
        && request.resource.data.kullaniciAdi is string
        && request.resource.data.kullaniciAdi.size() >= 3
        && request.resource.data.adSoyad is string
        && request.resource.data.adSoyad.size() >= 2
        && request.resource.data.email is string;
    }

    // Rezervasyon süresi dolmuşsa (veya expiresAt yoksa) başkası devralabilir.
    function usernameHoldDevralinabilir(data) {
      return !('expiresAt' in data)
        || !(data.expiresAt is timestamp)
        || data.expiresAt < request.time;
    }

    function usernameHoldBaskasindaAktif(username) {
      let yol = /databases/$(database)/documents/usernameHolds/$(username);
      return exists(yol)
        && get(yol).data.uid != request.auth.uid
        && !usernameHoldDevralinabilir(get(yol).data);
    }

    function usernameHoldOk(username) {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.kullaniciAdiKucuk == username
        && username.size() >= 3
        && username.size() <= 30
        && !exists(/databases/$(database)/documents/usernames/$(username));
    }

    match /pendingProfiles/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && pendingProfileOk(uid)
        && !exists(/databases/$(database)/documents/users/$(uid));
    }

    match /usernameHolds/{username} {
      // Önemli: belge yokken resource.data erişimi permission-denied verir.
      // Kayıt transaction'ı önce hold'u okur; yoksa da get izinli olmalı.
      // Aktif hold (uid/expiresAt) giriş yapan herkese açık — aksi halde
      // "başkasında mı / süresi doldu mu?" kontrolü yapılamaz.
      allow get: if isSignedIn();
      // Temizlik: kendi hold'larını uid ile sorgula.
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && usernameHoldOk(username);
      // Başkasının aktif rezervasyonu üzerine yazılamaz; süresi dolan devralınabilir
      allow update: if isSignedIn()
        && usernameHoldOk(username)
        && (
          resource.data.uid == request.auth.uid
          || usernameHoldDevralinabilir(resource.data)
        );
      allow delete: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/usernameHolds/$(username))
          || resource.data.uid == request.auth.uid
          || isModerator()
        );
    }

    // =========================================================================
    // usernames — benzersiz kullanıcı adı rezervasyonu
    // =========================================================================

    match /usernames/{username} {
      // Girişte oturum yokken kullanıcı adı → e-posta çözümlemesi için get açık.
      // list: giriş + tavan (tüm e-postaları tarama).
      allow get: if true;
      allow list: if isSignedIn()
        && request.query.limit is int
        && request.query.limit > 0
        && request.query.limit <= 40;
      allow create: if isSignedIn()
        && emailVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 320
        && username.size() >= 3
        && username.size() <= 30
        && !usernameHoldBaskasindaAktif(username);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['kullaniciAdi', 'email', 'createdAt']);
      allow delete: if isSignedIn() && (
        !exists(/databases/$(database)/documents/usernames/$(username))
        || resource.data.uid == request.auth.uid
      );
    }

    // =========================================================================
    // users — profil ve alt koleksiyonlar
    // =========================================================================

    match /users/{userId} {
      // Tekil profil: yalnızca girişli (UID tahmin etmek zor; REST anahtarı yetmez).
      // Liste: giriş + zorunlu tavan — limitsiz “hepsini ver” yok.
      allow get: if isSignedIn();
      allow list: if isSignedIn()
        && request.query.limit is int
        && request.query.limit > 0
        && request.query.limit <= 300;
      allow create: if isOwner(userId) && userCreateOk();
      // Önemli: ownerScoreUpdateOk çok dallı; önce ucuz robot/profil kuralları.
      // Aksi halde 1000 ifade limiti dolup renk/isim yazımı permission-denied olur.
      allow update: if (isOwner(userId) && ownerRobotGorunumOk())
        || (isOwner(userId) && ownerRobotBakimOk())
        || (isOwner(userId) && ownerReklamVilOk())
        || ownerYemekKisaOk(userId)
        || ownerGonderiSayacOk(userId)
        || (isOwner(userId) && ownerSosyalMaskotOdulYazOk())
        || ownerSosyalSkorKazanimOk(userId)
        || ownerSosyalGeriAlimOk(userId)
        || (isOwner(userId) && ownerYumurtaGelisimOk())
        || (isOwner(userId) && ownerRobotKurOk())
        || (isOwner(userId) && changedOnly(['robot']) && ownerVilHarcamaliYemekOk())
        || (isOwner(userId) && ownerRobotYemekYazOk())
        || (isOwner(userId) && ownerUserUpdateOk())
        || (isOwner(userId) && haftalikGorevUpdateOk())
        || (isOwner(userId) && haftaKapanisOdulOk())
        || arkadasMaskotYemekOk(userId)
        || ownerScoreUpdateOk(userId)
        || (isModerator()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['raporNedeniyleGizli', 'raporGuncellenmeTarihi']));
      allow delete: if isOwner(userId) || isModerator();

      // account: yalnızca sahip. loginEmail: kullanıcı adı ile giriş (sadece e-posta).
      match /private/{docId} {
        allow get: if docId == 'loginEmail'
          || (isOwner(userId) && docId == 'account');
        allow list: if false;
        allow create, update, delete: if isOwner(userId)
          && (docId == 'account' || docId == 'loginEmail');
      }

      match /following/{targetId} {
        allow read: if canReadSocialGraph(userId)
          || request.auth.uid == userId
          || (request.auth.uid == targetId
            && bekleyenTakipIstegiVar(targetId, userId));
        allow create: if followingCreateOk(userId, targetId);
        allow update: if followingCreateOk(userId, targetId);
        allow delete: if isOwner(userId) || request.auth.uid == targetId || isModerator();
      }

      match /retyBaglari/{otherUid} {
        allow get: if isOwner(userId) || request.auth.uid == otherUid;
        allow list: if isOwner(userId);
        allow create: if isSignedIn()
          && retyBagYazOk()
          && (
            isOwner(userId)
            || (
              request.auth.uid == otherUid
              && request.auth.uid != userId
              && karsilikliTakipOk(request.auth.uid, userId)
            )
          );
        allow update: if isSignedIn()
          && (
            (
              retyBagYazOk()
              && (
                isOwner(userId)
                || (
                  request.auth.uid == otherUid
                  && request.auth.uid != userId
                  && karsilikliTakipOk(request.auth.uid, userId)
                )
              )
            )
            || retyBagTakipKesmeOk(userId, otherUid)
          );
        allow delete: if isOwner(userId) || request.auth.uid == otherUid;
      }

      match /followers/{followerId} {
        allow read: if canReadSocialGraph(userId)
          || request.auth.uid == userId
          || (request.auth.uid == followerId
            && bekleyenTakipIstegiVar(userId, followerId));
        allow create: if followerCreateOk(userId, followerId);
        allow update: if followerCreateOk(userId, followerId);
        allow delete: if isOwner(userId) || request.auth.uid == followerId || isModerator();
      }

      match /followRequests/{requesterId} {
        allow read: if isOwner(userId) || request.auth.uid == requesterId;
        allow create: if request.auth.uid == requesterId
          && request.resource.data.userId == requesterId
          && get(/databases/$(database)/documents/users/$(userId)).data.hesapGizli == true;
        allow delete: if isOwner(userId) || request.auth.uid == requesterId;
        allow update: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.gonderenUid == request.auth.uid);
        allow create: if isSignedIn() && notificationCreateOk(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['okundu']);
        allow delete: if isOwner(userId)
          || (isSignedIn() && resource.data.gonderenUid == request.auth.uid);
      }

      match /blocked/{blockedId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || request.auth.uid == blockedId;
      }

      match /blockedBy/{blockerId} {
        allow read: if isOwner(userId);
        allow create, update: if request.auth.uid == blockerId;
        allow delete: if request.auth.uid == blockerId || isOwner(userId);
      }

      match /likedPosts/{postId} {
        allow read: if isOwner(userId)
          || (isSignedIn() && resource.data.postOwnerId == request.auth.uid);
        allow create: if isOwner(userId)
          && request.resource.data.postId == postId
          && begeniKaydiVarSonra(postId)
          && (!('puanAlindi' in request.resource.data)
              || request.resource.data.puanAlindi is bool);
        allow delete: if isOwner(userId);
        // Gönderi sahibi avatar/ad senkronu (beğenilenler anlık görüntüsü).
        allow update: if isSignedIn()
          && resource.data.postOwnerId == request.auth.uid
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.postOwnerId == resource.data.postOwnerId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['kullaniciAdi', 'avatarKey', 'photoUrl']);
      }

      // Beğeni ödülü/geri çekme ücreti gönderi başına bir kez.
      match /begeniOdulleri/{postId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['geriAlindi', 'createdAt', 'guncellendi'])
          && request.resource.data.geriAlindi is bool;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['geriAlindi', 'guncellendi'])
          && resource.data.geriAlindi != true
          && request.resource.data.geriAlindi == true;
      }

      match /followRewarded/{targetId} {
        allow read: if isOwner(userId) || request.auth.uid == targetId;
        allow create: if followRewardedCreateOk(userId, targetId);
        allow delete: if isOwner(userId)
          && resource.data.puanVerildi != true;
        allow update: if isOwner(userId)
          && request.resource.data.targetUid == resource.data.targetUid
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puanVerildi'])
              && request.resource.data.puanVerildi == true
              && (
                resource.data.puanVerildi == false
                || !('puanVerildi' in resource.data)
              )
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vilGeriAlindi'])
              && resource.data.puanVerildi == true
              && resource.data.vilGeriAlindi != true
              && request.resource.data.vilGeriAlindi == true
              && request.resource.data.puanVerildi == true
            )
          );
      }
    }

    // =========================================================================
    // posts — akış, beğeni, yorum
    // Sorgular:
    //   Keşfet: ownerHesapGizli==false, raporNedeniyleGizli==false
    //   Takip: userId==X, raporNedeniyleGizli==false
    //   Profil: userId==X
    // =========================================================================

    match /sabitGonderiler/{postId} {
      allow get: if !exists(/databases/$(database)/documents/sabitGonderiler/$(postId))
        || canReadPostData(resource.data);
      allow list: if canReadPostData(resource.data);
      allow create: if false;
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid
          && (ownerPostUpdateOk() || postCounterUpdateOk(postId)))
        || (resource.data.userId != request.auth.uid && (
          postCounterUpdateOk(postId) || postReportUpdateOk(postId)
        ))
        || (isModerator() && moderatorContentUpdateOk())
      );
      allow delete: if false;

      match /likes/{likeId} {
        allow read: if isSignedIn()
          && (postOwner(postId) == request.auth.uid
              || likeId == request.auth.uid);
        allow create: if isSignedIn()
          && canReadPost(postId)
          && request.auth.uid == likeId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn()
          && (request.auth.uid == likeId || postOwner(postId) == request.auth.uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if !yorumKaydiVar(postId, commentId)
          || canReadPost(postId)
          || request.auth.uid == resource.data.userId;
        allow create: if canReadPost(postId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.metin is string
          && request.resource.data.metin.size() > 0
          && request.resource.data.metin.size() <= 1000
          && request.resource.data.sikayetSayisi == 0
          && request.resource.data.raporNedeniyleGizli == false
          && (!('bahsetmeler' in request.resource.data)
              || (request.resource.data.bahsetmeler is list
                  && request.resource.data.bahsetmeler.size() <= 10))
          && (!('mentionUidleri' in request.resource.data)
              || request.resource.data.mentionUidleri is map)
          && (!('parentId' in request.resource.data)
              || (request.resource.data.parentId is string
                  && request.resource.data.parentId.size() > 0
                  && request.resource.data.parentId.size() <= 128
                  && yorumKaydiVar(postId, request.resource.data.parentId)));
        allow update: if canReadPost(postId) && (
          commentReportUpdateOk(postId, commentId)
          || (isModerator() && moderatorContentUpdateOk())
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.metin == resource.data.metin
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['kullaniciAdi', 'avatarKey', 'photoUrl'])
          )
        );
        allow delete: if resource.data.userId == request.auth.uid
          || (canReadPost(postId) && postOwner(postId) == request.auth.uid)
          || (
            'parentId' in resource.data
            && resource.data.parentId is string
            && resource.data.parentId.size() > 0
            && yorumKaydiVar(postId, resource.data.parentId)
            && yorumSahibi(postId, resource.data.parentId) == request.auth.uid
          );
      }
    }

    match /posts/{postId} {
      // list: exists() içeren OR sorguları bozar (özellikle web).
      // get: belge yokken resource.data permission-denied vermesin.
      allow get: if !exists(/databases/$(database)/documents/posts/$(postId))
        || canReadPostData(resource.data)
        || begendigiPostMu(postId);
      allow list: if canReadPostData(resource.data);
      allow create: if isSignedIn() && postCreateOk();
      allow update: if isSignedIn() && (
        (postSahibiUid(resource.data) == request.auth.uid
          && (ownerPostUpdateOk() || postCounterUpdateOk(postId)))
        || (postSahibiUid(resource.data) != request.auth.uid && (
          postCounterUpdateOk(postId) || postReportUpdateOk(postId)
        ))
        || (isModerator() && moderatorContentUpdateOk())
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /likes/{likeId} {
        allow read: if isSignedIn()
          && (postOwner(postId) == request.auth.uid
              || likeId == request.auth.uid);
        allow create: if isSignedIn()
          && canReadPost(postId)
          && request.auth.uid == likeId
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn()
          && (request.auth.uid == likeId || postOwner(postId) == request.auth.uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if !exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId))
          || canReadPost(postId)
          || request.auth.uid == resource.data.userId;
        allow create: if canReadPost(postId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.metin is string
          && request.resource.data.metin.size() > 0
          && request.resource.data.metin.size() <= 1000
          && request.resource.data.sikayetSayisi == 0
          && request.resource.data.raporNedeniyleGizli == false
          && (!('bahsetmeler' in request.resource.data)
              || (request.resource.data.bahsetmeler is list
                  && request.resource.data.bahsetmeler.size() <= 10))
          && (!('mentionUidleri' in request.resource.data)
              || request.resource.data.mentionUidleri is map)
          && (!('parentId' in request.resource.data)
              || (request.resource.data.parentId is string
                  && request.resource.data.parentId.size() > 0
                  && request.resource.data.parentId.size() <= 128
                  && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId))));
        allow update: if canReadPost(postId) && (
          commentReportUpdateOk(postId, commentId)
          || (isModerator() && moderatorContentUpdateOk())
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.metin == resource.data.metin
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['kullaniciAdi', 'avatarKey', 'photoUrl'])
          )
        );
        allow delete: if resource.data.userId == request.auth.uid
          || (canReadPost(postId) && postOwner(postId) == request.auth.uid)
          || (
            'parentId' in resource.data
            && resource.data.parentId is string
            && resource.data.parentId.size() > 0
            && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(resource.data.parentId))
            && get(/databases/$(database)/documents/posts/$(postId)/comments/$(resource.data.parentId)).data.userId == request.auth.uid
          );
      }
    }

    // =========================================================================
    // supportTickets — uygulama içi destek ve geri bildirim
    // =========================================================================

    match /supportTickets/{ticketId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isModerator());
      allow create: if isSignedIn() && supportTicketCreateOk();
      allow update: if isModerator() && supportTicketUpdateOk();
      allow delete: if isModerator()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /hesapSilmeGeriBildirimleri/{docId} {
      allow read: if isModerator();
      allow create: if isSignedIn() && hesapSilmeGeriBildirimOk();
      allow update, delete: if isModerator();
    }

    // =========================================================================
    // reports — moderasyon kuyruğu
    // =========================================================================

    match /reports/{reportId} {
      // Belge yokken "zaten şikayet ettin mi" okuması permission-denied vermesin.
      allow get: if isModerator()
        || (isSignedIn()
          && (resource == null || resource.data.reporterUid == request.auth.uid));
      allow list: if isModerator()
        || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if isSignedIn() && reportCreateOk();
      allow update: if isModerator() && reportUpdateOk();
      // Hedef kullanıcı şikayet kanıtını silemesin.
      allow delete: if isModerator()
        || (isSignedIn()
          && resource.data.reporterUid == request.auth.uid
          && resource.data.status == 'pending');
    }

    // =========================================================================
    // chats — özel mesajlaşma
    // =========================================================================

    match /chats/{chatId} {
      // Belge yokken resource.data permission-denied vermesin (get-then-set).
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId))
        || request.auth.uid in resource.data.participants
      );
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && notBlockedPair(chatOtherParticipant(request.resource.data.participants))
        && userIsChild(request.auth.uid) != true
        && userIsChild(chatOtherParticipant(request.resource.data.participants)) != true;
      allow update: if isSignedIn() && (
        (
          request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() == 2
          && (
            !resource.data.keys().hasAny(['participants'])
            || request.auth.uid in resource.data.participants
          )
          && notBlockedPair(chatOtherParticipant(request.resource.data.participants))
          && userIsChild(request.auth.uid) != true
          && userIsChild(chatOtherParticipant(request.resource.data.participants)) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        )
        || (
          request.auth.uid in resource.data.participants
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'updatedAt',
                'lastMessage',
                'lastMessageAt',
                'lastSenderUid',
                'lastSeenBy',
                'hiddenBy',
                'mutedBy'
              ])
        )
      );
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.metin is string
          && request.resource.data.metin.size() <= 2000
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && notBlockedPair(chatOtherParticipant(
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          ))
          && (!('mesajTipi' in request.resource.data)
              || request.resource.data.mesajTipi in ['text', 'post_forward'])
          && (!('postId' in request.resource.data)
              || request.resource.data.postId is string)
          && (request.resource.data.metin.size() > 0
              || (request.resource.data.get('mesajTipi', 'text') == 'post_forward'
                  && request.resource.data.postId.size() > 0))
          && (!('bahsetmeler' in request.resource.data)
              || (request.resource.data.bahsetmeler is list
                  && request.resource.data.bahsetmeler.size() <= 10))
          && (!('mentionUidleri' in request.resource.data)
              || request.resource.data.mentionUidleri is map)
          && userIsChild(request.auth.uid) != true
          && userIsChild(chatOtherParticipant(
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )) != true;
        allow update: if isSignedIn()
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'metin']);
        allow delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // =========================================================================
    // Collection group — hesap silme sorguları
    // (collectionGroup('comments'|'followRequests'|...) ile uyumlu)
    // =========================================================================

    match /{path=**}/comments/{commentId} {
      allow read, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/followRequests/{requestId} {
      allow read, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/followRewarded/{rewardId} {
      allow read, delete: if isSignedIn()
        && resource.data.targetUid == request.auth.uid;
    }

    match /{path=**}/notifications/{notificationId} {
      allow read, delete: if isSignedIn()
        && resource.data.gonderenUid == request.auth.uid;
    }
  }
}
