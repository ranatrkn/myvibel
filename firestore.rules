rules_version = '2';

// MyVibel — Firestore güvenlik kuralları
// Koleksiyonlar: usernames, users (+ alt koleksiyonlar), posts (+ likes/comments),
// reports, chats (+ messages)

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Kimlik ve roller
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isModerator() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true;
    }

    /// E-posta doğrulanmış veya Google/Apple bağlı hesap
    /// (şifreyle girişte sign_in_provider=password olsa bile identities'te OAuth kalır).
    function emailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com'
        || request.auth.token.firebase.sign_in_provider == 'apple.com'
        || ('google.com' in request.auth.token.firebase.identities)
        || ('apple.com' in request.auth.token.firebase.identities)
      );
    }

    /// Karşılıklı engel yok (gönderenin blocked / blockedBy görünümü).
    function notBlockedPair(otherUid) {
      return otherUid is string
        && otherUid.size() > 0
        && otherUid != request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(otherUid))
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedBy/$(otherUid));
    }

    function chatOtherParticipant(parts) {
      return parts[0] == request.auth.uid ? parts[1] : parts[0];
    }

    function yearsSince(ts) {
      return request.time.year() - ts.year()
        - ((request.time.month() < ts.month()
            || (request.time.month() == ts.month()
              && request.time.day() < ts.day())) ? 1 : 0);
    }

    function ownAccountPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid)/private/account;
    }

    function ownIsChildAccount() {
      return exists(ownAccountPath())
        && 'dogumTarihi' in get(ownAccountPath()).data
        && yearsSince(get(ownAccountPath()).data.dogumTarihi) >= 15
        && yearsSince(get(ownAccountPath()).data.dogumTarihi) < 18;
    }

    function userIsChild(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.keys().hasAny(['cocukHesabi'])
        && get(/databases/$(database)/documents/users/$(uid)).data.cocukHesabi == true;
    }

    function yasBayrakUyumlu() {
      return ownIsChildAccount()
        ? (request.resource.data.cocukHesabi == true
            && request.resource.data.hesapGizli == true)
        : (request.resource.data.get('cocukHesabi', false) != true);
    }

    function createAgeOk() {
      let acc = ownAccountPath();
      return existsAfter(acc)
        && 'dogumTarihi' in getAfter(acc).data
        && yearsSince(getAfter(acc).data.dogumTarihi) >= 15
        && (
          yearsSince(getAfter(acc).data.dogumTarihi) >= 18
            ? request.resource.data.get('cocukHesabi', false) != true
            : (request.resource.data.cocukHesabi == true
                && request.resource.data.hesapGizli == true)
        );
    }

    // -------------------------------------------------------------------------
    // Alan yardımcıları
    // -------------------------------------------------------------------------

    function intField(data, field, fallback) {
      return data[field] is number ? data[field] : fallback;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function intChangedBy(field, delta) {
      return intField(request.resource.data, field, 0)
        == intField(resource.data, field, 0) + delta;
    }

    function userCountersNonNegative() {
      return intField(request.resource.data, 'puan', 0) >= 0
        && intField(request.resource.data, 'gonderiSayisi', 0) >= 0
        && intField(request.resource.data, 'begeniSayisi', 0) >= 0
        && intField(request.resource.data, 'yorumSayisi', 0) >= 0;
    }

    // Eksik map anahtarına erişim hata fırlatır (false değil); hiç beslenmemiş
    // Vibel'de 'tokluk' yoktur. Bu yüzden alanlar get() ile okunur.
    function robotSeviyeFrom(data) {
      return data.get('robot', null) is map && data.robot.get('seviye', null) is number
        ? data.robot.seviye
        : 1;
    }

    function robotEtkilesimPuaniFrom(data) {
      return data.get('robot', null) is map && data.robot.get('etkilesimPuani', null) is number
        ? data.robot.etkilesimPuani
        : 0;
    }

    function robotToklukFrom(data) {
      return data.get('robot', null) is map && data.robot.get('tokluk', null) is number
        ? data.robot.tokluk
        : 0;
    }

    function robotEtkilesimPuaniChangedBy(delta) {
      return robotEtkilesimPuaniFrom(request.resource.data)
          == robotEtkilesimPuaniFrom(resource.data) + delta;
    }

    function robotGelisimFrom(data) {
      return data.get('robot', null) is map && data.robot.get('gelisimPuani', null) is number
        ? data.robot.gelisimPuani
        : 0;
    }

    function sosyalVilKazaniyor(miktar) {
      return resource.data.robot is map
        && request.resource.data.robot is map
        && robotSeviyeFrom(resource.data) >= 6
        && robotSeviyeFrom(request.resource.data) == robotSeviyeFrom(resource.data)
        && robotEtkilesimPuaniChangedBy(miktar)
        && miktar > 0
        && robotGelisimFrom(request.resource.data)
            == robotGelisimFrom(resource.data);
    }

    // Seviye 1–5: aynı işlemde gelişim (vil değil).
    function sosyalGelisimKazaniyor(miktar) {
      let eskiSeviye = robotSeviyeFrom(resource.data);
      let yeniSeviye = robotSeviyeFrom(request.resource.data);
      return resource.data.robot is map
        && request.resource.data.robot is map
        && eskiSeviye < 6
        && robotEtkilesimPuaniFrom(request.resource.data)
            == robotEtkilesimPuaniFrom(resource.data)
        && yeniSeviye >= eskiSeviye
        && yeniSeviye <= 6
        && yeniSeviye <= eskiSeviye + 1
        && (
          (yeniSeviye == eskiSeviye
            && robotGelisimFrom(request.resource.data)
                == robotGelisimFrom(resource.data) + miktar)
          || yeniSeviye == eskiSeviye + 1
        );
    }

    function sosyalMaskotOdulOk(miktar) {
      return sosyalVilKazaniyor(miktar) || sosyalGelisimKazaniyor(miktar);
    }

    // Yalnızca robot + sabit vil/gelişim adımı. İstek tarafındaki seviye/gelişim
    // karşılaştırması noktalı yazımda varsayılan 1/0 görünüp ödülü kesiyordu.
    function ownerSosyalMaskotOdulYazOk() {
      return changedOnly(['robot'])
        && resource.data.robot is map
        && (
          (robotSeviyeFrom(resource.data) >= 6
            && (
              robotEtkilesimPuaniChangedBy(2)
              || robotEtkilesimPuaniChangedBy(3)
              || robotEtkilesimPuaniChangedBy(5)
              || robotEtkilesimPuaniChangedBy(10)
            ))
          || (robotSeviyeFrom(resource.data) < 6
            && (
              robotGelisimFrom(request.resource.data)
                  == robotGelisimFrom(resource.data) + 2
              || robotGelisimFrom(request.resource.data)
                  == robotGelisimFrom(resource.data) + 3
              || robotGelisimFrom(request.resource.data)
                  == robotGelisimFrom(resource.data) + 5
              || robotGelisimFrom(request.resource.data)
                  == robotGelisimFrom(resource.data) + 10
              || robotSeviyeFrom(request.resource.data)
                  == robotSeviyeFrom(resource.data) + 1
            ))
        );
    }

    // Beğeni/yorum/takip puanı ownerScoreUpdateOk'un sonundaydı; 1000 ifade
    // limiti yüzünden permission-denied oluyordu. Ucuz kazanç yolları önce.
    function begeniOdulIlkKez(userId, postId) {
      return !exists(/databases/$(database)/documents/users/$(userId)/begeniOdulleri/$(postId))
        && existsAfter(/databases/$(database)/documents/users/$(userId)/begeniOdulleri/$(postId));
    }

    function ownerSosyalSkorKazanimOk(userId) {
      return isOwner(userId)
        && userCountersNonNegative()
        && (
          (changedOnly(['puan', 'yorumSayisi', 'sonYorumPuanPostId', 'sonYorumPuanCommentId'])
            && intChangedBy('puan', 3)
            && intChangedBy('yorumSayisi', 1)
            && request.resource.data.sonYorumPuanPostId is string
            && request.resource.data.sonYorumPuanPostId.size() > 0
            && request.resource.data.sonYorumPuanCommentId is string
            && request.resource.data.sonYorumPuanCommentId.size() > 0
            && yorumPuanOncesiYok(request.resource.data.sonYorumPuanPostId, request.resource.data.sonYorumPuanCommentId)
            && yorumPuanSonrasiBenim(request.resource.data.sonYorumPuanPostId, request.resource.data.sonYorumPuanCommentId, userId))
          || (changedOnly(['puan', 'begeniSayisi', 'sonBegeniPuanPostId'])
            && intChangedBy('puan', 2)
            && intChangedBy('begeniSayisi', 1)
            && request.resource.data.sonBegeniPuanPostId is string
            && request.resource.data.sonBegeniPuanPostId.size() > 0
            && !exists(/databases/$(database)/documents/users/$(userId)/likedPosts/$(request.resource.data.sonBegeniPuanPostId))
            && existsAfter(/databases/$(database)/documents/users/$(userId)/likedPosts/$(request.resource.data.sonBegeniPuanPostId))
            && begeniOdulIlkKez(userId, request.resource.data.sonBegeniPuanPostId)
            && !begeniKaydiVar(request.resource.data.sonBegeniPuanPostId)
            && begeniKaydiVarSonra(request.resource.data.sonBegeniPuanPostId))
          || (changedOnly(['begeniSayisi', 'sonBegeniPuanPostId'])
            && intChangedBy('begeniSayisi', 1)
            && request.resource.data.sonBegeniPuanPostId is string
            && request.resource.data.sonBegeniPuanPostId.size() > 0
            && exists(/databases/$(database)/documents/users/$(userId)/begeniOdulleri/$(request.resource.data.sonBegeniPuanPostId))
            && !exists(/databases/$(database)/documents/users/$(userId)/likedPosts/$(request.resource.data.sonBegeniPuanPostId))
            && existsAfter(/databases/$(database)/documents/users/$(userId)/likedPosts/$(request.resource.data.sonBegeniPuanPostId))
            && !begeniKaydiVar(request.resource.data.sonBegeniPuanPostId)
            && begeniKaydiVarSonra(request.resource.data.sonBegeniPuanPostId))
          || (changedOnly(['puan', 'sonTakipOdulUid'])
            && intChangedBy('puan', 5)
            && request.resource.data.sonTakipOdulUid is string
            && request.resource.data.sonTakipOdulUid.size() > 0
            && !exists(/databases/$(database)/documents/users/$(userId)/followRewarded/$(request.resource.data.sonTakipOdulUid))
            && existsAfter(/databases/$(database)/documents/users/$(userId)/followRewarded/$(request.resource.data.sonTakipOdulUid)))
          || (changedOnly(['puan', 'sonTakipOdulUid'])
            && intChangedBy('puan', 5)
            && request.resource.data.sonTakipOdulUid is string
            && request.resource.data.sonTakipOdulUid.size() > 0
            && exists(/databases/$(database)/documents/users/$(userId)/followRewarded/$(request.resource.data.sonTakipOdulUid))
            && get(/databases/$(database)/documents/users/$(userId)/followRewarded/$(request.resource.data.sonTakipOdulUid)).data.puanVerildi == false
            && getAfter(/databases/$(database)/documents/users/$(userId)/followRewarded/$(request.resource.data.sonTakipOdulUid)).data.puanVerildi == true)
        );
    }

    // Robot alanı hiç yoksa ilk Vibel belgesini oluştur.
    function ownerRobotKurOk() {
      return !('robot' in resource.data)
        && request.resource.data.robot is map
        && changedOnly(['robot'])
        && robotSeviyeFrom(request.resource.data) == 1
        && robotGelisimFrom(request.resource.data) >= 0
        && robotGelisimFrom(request.resource.data) <= 10
        && robotEtkilesimPuaniFrom(request.resource.data) >= 0
        && robotEtkilesimPuaniFrom(request.resource.data) <= 10;
    }

    // 1–5: gelişim / +1 seviye. İç alan hasOnly şartı yok (web map rewrite).
    function ownerYumurtaGelisimOk() {
      let eskiSeviye = robotSeviyeFrom(resource.data);
      let yeniSeviye = robotSeviyeFrom(request.resource.data);
      return resource.data.robot is map
        && request.resource.data.robot is map
        && changedOnly(['robot'])
        && eskiSeviye < 6
        && yeniSeviye >= eskiSeviye
        && yeniSeviye <= eskiSeviye + 1
        && yeniSeviye <= 6
        && robotEtkilesimPuaniFrom(request.resource.data)
            == robotEtkilesimPuaniFrom(resource.data)
        && (
          (yeniSeviye == eskiSeviye
            && (
              robotGelisimFrom(request.resource.data)
                  == robotGelisimFrom(resource.data) + 2
              || robotGelisimFrom(request.resource.data)
                  == robotGelisimFrom(resource.data) + 3
              || robotGelisimFrom(request.resource.data)
                  == robotGelisimFrom(resource.data) + 5
              || robotGelisimFrom(request.resource.data)
                  == robotGelisimFrom(resource.data) + 10
            ))
          || (yeniSeviye == eskiSeviye + 1
            && robotGelisimFrom(request.resource.data)
                <= robotGelisimFrom(resource.data) + 10)
        );
    }

    // Profil / yemek / uyku: vil artmasın, seviye zıplamasın, tokluk +20 tavan.
    function ownerRobotBakimOk() {
      return resource.data.robot is map
        && request.resource.data.robot is map
        && changedOnly(['robot'])
        && robotEtkilesimPuaniFrom(request.resource.data)
            <= robotEtkilesimPuaniFrom(resource.data)
        && robotSeviyeFrom(request.resource.data)
            <= robotSeviyeFrom(resource.data) + 1
        && robotToklukFrom(request.resource.data) <= 100
        && (
          robotToklukFrom(request.resource.data)
              <= robotToklukFrom(resource.data) + 20
          || ownerVilHarcamaliYemekOk()
        )
        && (!('isim' in request.resource.data.robot)
            || !(request.resource.data.robot.isim is string)
            || request.resource.data.robot.isim.size() <= 24);
    }

    // Vibel ismi / rengi: seviye ve vil sabit kalsın (iç alan diff'ine güvenme).
    function ownerRobotGorunumOk() {
      return resource.data.robot is map
        && request.resource.data.robot is map
        && changedOnly(['robot'])
        && robotSeviyeFrom(request.resource.data)
            == robotSeviyeFrom(resource.data)
        && robotEtkilesimPuaniFrom(request.resource.data)
            == robotEtkilesimPuaniFrom(resource.data)
        && robotGelisimFrom(request.resource.data)
            == robotGelisimFrom(resource.data)
        && robotToklukFrom(request.resource.data)
            <= robotToklukFrom(resource.data)
        && (!('isim' in request.resource.data.robot)
            || !(request.resource.data.robot.isim is string)
            || request.resource.data.robot.isim.size() <= 24)
        && (
          robotSeviyeFrom(resource.data) >= 5
          || !('isim' in resource.data.robot)
          || !('isim' in request.resource.data.robot)
          || request.resource.data.robot.isim == resource.data.robot.isim
        )
        && (!('renk' in request.resource.data.robot)
            || (request.resource.data.robot.renk is string
                && request.resource.data.robot.renk.size() > 0
                && request.resource.data.robot.renk.size() <= 32));
    }

    // 15 vil harcanınca tokluk 0–100 arası serbest (açlık düşüşü + yemek).
    function ownerVilHarcamaliYemekOk() {
      return robotSeviyeFrom(resource.data) >= 6
        && robotEtkilesimPuaniFrom(resource.data)
            - robotEtkilesimPuaniFrom(request.resource.data) == 15
        && robotEtkilesimPuaniFrom(request.resource.data) >= 0
        && robotToklukFrom(request.resource.data) >= 0
        && robotToklukFrom(request.resource.data) <= 100;
    }

    // Sadece robot değişsin; vil artmasın. hasOnly bazen fazla alan görüyor.
    function ownerRobotYemekYazOk() {
      return resource.data.robot is map
        && request.resource.data.robot is map
        && robotSeviyeFrom(resource.data) >= 6
        && robotSeviyeFrom(request.resource.data)
            <= robotSeviyeFrom(resource.data) + 1
        && robotToklukFrom(request.resource.data) >= 0
        && robotToklukFrom(request.resource.data) <= 100
        && robotEtkilesimPuaniFrom(request.resource.data) >= 0
        && robotEtkilesimPuaniFrom(request.resource.data)
            <= robotEtkilesimPuaniFrom(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'puan',
              'isModerator',
              'kullaniciAdi',
              'adSoyad',
              'uid',
              'email',
              'hesapGizli',
              'aramaSkoru',
              'raporNedeniyleGizli',
              'gonderiSayisi',
              'begeniSayisi',
              'yorumSayisi',
              'reklamVil'
            ]);
    }

    function gonderiSilPostIdOk() {
      let postId = request.resource.data.sonGonderiPuanPostId;
      return postId is string
        && postId.size() > 0
        && exists(/databases/$(database)/documents/posts/$(postId))
        && !existsAfter(/databases/$(database)/documents/posts/$(postId));
    }

    function sosyalVilHarcaniyor(miktar) {
      return robotSeviyeFrom(resource.data) >= 6
        && robotEtkilesimPuaniFrom(resource.data) >= miktar
        && robotEtkilesimPuaniChangedBy(-miktar)
        && request.resource.data.robot.seviye == resource.data.robot.seviye
        && request.resource.data.robot.diff(resource.data.robot)
            .affectedKeys().hasOnly(['etkilesimPuani']);
    }

    // Ödüllü reklam: +15 vil, Türkiye gününe göre günde en fazla 5.
    function ownerReklamVilOk() {
      let eski = resource.data.get('reklamVil', null);
      let yeni = request.resource.data.get('reklamVil', null);
      let bugun = math.floor((request.time.toMillis() + 10800000) / 86400000);
      let eskiGun = eski is map && eski.get('gun', null) is int ? eski.gun : -1;
      let eskiAdet = eski is map && eski.get('adet', null) is int ? eski.adet : 0;
      return changedOnly(['robot', 'reklamVil'])
        && resource.data.get('robot', null) is map
        && robotSeviyeFrom(resource.data) >= 6
        && request.resource.data.robot.diff(resource.data.robot)
            .affectedKeys().hasOnly(['etkilesimPuani'])
        && robotEtkilesimPuaniChangedBy(15)
        && yeni is map
        && yeni.keys().hasOnly(['gun', 'adet'])
        && yeni.gun is int
        && yeni.adet is int
        && (yeni.gun == bugun || yeni.gun == bugun - 1)
        && yeni.gun >= eskiGun
        && yeni.adet == (yeni.gun == eskiGun ? eskiAdet + 1 : 1)
        && yeni.adet <= 5;
    }

    function gonderiSilVilHarcaniyor() {
      return sosyalVilHarcaniyor(3);
    }

    function arkadasMaskotYemekOk(userId) {
      let ust = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && request.auth.uid != userId
        && (karsilikliTakipOk(request.auth.uid, userId)
          || exists(/databases/$(database)/documents/users/$(userId)/retyBaglari/$(request.auth.uid)))
        && request.resource.data.robot is map
        && !ust.hasAny([
          'puan',
          'isModerator',
          'kullaniciAdi',
          'adSoyad',
          'uid',
          'email',
          'hesapGizli',
          'aramaSkoru',
          'raporNedeniyleGizli',
          'reklamVil'
        ])
        && robotToklukFrom(request.resource.data) <= 100
        && robotToklukFrom(request.resource.data)
            <= robotToklukFrom(resource.data) + 20
        && robotToklukFrom(request.resource.data)
            >= robotToklukFrom(resource.data);
    }

    function yorumSilOdulGeriAlOk(userId) {
      let postId = request.resource.data.sonYorumPuanPostId;
      let commentId = request.resource.data.sonYorumPuanCommentId;
      return postId is string
        && postId.size() > 0
        && commentId is string
        && commentId.size() > 0
        && yorumKaydiVar(postId, commentId)
        && !yorumKaydiVarSonra(postId, commentId)
        && yorumSahibi(postId, commentId) == userId
        && postOwner(postId) != userId;
    }

    function takipGeriAlOdulOk(userId) {
      let hedef = request.resource.data.sonTakipOdulUid;
      let odulYol = /databases/$(database)/documents/users/$(userId)/followRewarded/$(hedef);
      return hedef is string
        && hedef.size() > 0
        && exists(odulYol)
        && existsAfter(odulYol)
        && get(odulYol).data.puanVerildi == true
        && get(odulYol).data.vilGeriAlindi != true
        && getAfter(odulYol).data.vilGeriAlindi == true
        && exists(/databases/$(database)/documents/users/$(userId)/following/$(hedef))
        && !existsAfter(/databases/$(database)/documents/users/$(userId)/following/$(hedef));
    }

    // -------------------------------------------------------------------------
    // Sosyal grafik
    // -------------------------------------------------------------------------

    function isFollower(ownerUid, followerUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/followers/$(followerUid));
    }

    function isFollowing(followerUid, targetUid) {
      return exists(/databases/$(database)/documents/users/$(followerUid)/following/$(targetUid));
    }

    function karsilikliTakipOk(uidA, uidB) {
      return (isFollowing(uidA, uidB) || isFollower(uidB, uidA))
        && (isFollowing(uidB, uidA) || isFollower(uidA, uidB));
    }

    function retyBagYazOk() {
      return request.resource.data.keys()
        .hasOnly(['benimMs', 'onunMs', 'ilkMs', 'takipKesildiMs']);
    }

    // Takipten çıkınca 3 günlük silme süresini yaz/iptal et.
    function retyBagTakipKesmeOk(ownerUid, bagOtherUid) {
      return isSignedIn()
        && (isOwner(ownerUid) || request.auth.uid == bagOtherUid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['takipKesildiMs'])
        && (
          !('takipKesildiMs' in request.resource.data)
          || (
            request.resource.data.takipKesildiMs is int
            && request.resource.data.takipKesildiMs > 0
            && (
              !('takipKesildiMs' in resource.data)
              || request.resource.data.takipKesildiMs == resource.data.takipKesildiMs
            )
          )
        );
    }

    function userIsPrivate(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.hesapGizli == true;
    }

    function canReadSocialGraph(uid) {
      return isSignedIn()
        && (
          isOwner(uid)
          || isModerator()
          || userIsPrivate(uid) != true
          || isFollower(uid, request.auth.uid)
        );
    }

    // -------------------------------------------------------------------------
    // Gönderi görünürlüğü (feed sorgularıyla uyumlu)
    // -------------------------------------------------------------------------

    function canReadPostData(data) {
      // ownerHesapGizli sorgularla uyumlu; canlı userIsPrivate() sorgu sonuçlarını bozar.
      return isSignedIn()
        && (
          data.raporNedeniyleGizli != true
          || data.userId == request.auth.uid
          || isModerator()
        )
        && (
          data.ownerHesapGizli != true
          || data.userId == request.auth.uid
          || isFollower(data.userId, request.auth.uid)
          || isModerator()
        );
    }

    function begendigiPostMu(postId) {
      return isSignedIn()
        && (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/likedPosts/$(postId))
          || exists(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid))
          || exists(/databases/$(database)/documents/sabitGonderiler/$(postId)/likes/$(request.auth.uid))
        );
    }

    function canReadPost(postId) {
      return (
        exists(/databases/$(database)/documents/sabitGonderiler/$(postId))
        && canReadPostData(get(/databases/$(database)/documents/sabitGonderiler/$(postId)).data)
      ) || (
        exists(/databases/$(database)/documents/posts/$(postId))
        && canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data)
      ) || begendigiPostMu(postId);
    }

    function postOwner(postId) {
      return exists(/databases/$(database)/documents/sabitGonderiler/$(postId))
        ? postSahibiUid(get(/databases/$(database)/documents/sabitGonderiler/$(postId)).data)
        : exists(/databases/$(database)/documents/posts/$(postId))
          ? postSahibiUid(get(/databases/$(database)/documents/posts/$(postId)).data)
          : '';
    }

    // -------------------------------------------------------------------------
    // Kullanıcı doğrulama
    // -------------------------------------------------------------------------

    function userCreateOk() {
      return emailVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.puan == 0
        && request.resource.data.gonderiSayisi == 0
        && request.resource.data.begeniSayisi == 0
        && request.resource.data.yorumSayisi == 0
        && createAgeOk()
        && request.resource.data.aramaSkoru == 0
        && !('isModerator' in request.resource.data)
        && !('reklamVil' in request.resource.data)
        && !('email' in request.resource.data)
        && !('dogumTarihi' in request.resource.data)
        && request.resource.data.kullaniciAdi is string
        && request.resource.data.kullaniciAdi.size() >= 3
        && request.resource.data.kullaniciAdi.size() <= 30
        && request.resource.data.adSoyad is string
        && request.resource.data.adSoyad.size() >= 2
        && request.resource.data.adSoyad.size() <= 80;
    }

    function ownerUserUpdateOk() {
      return changedOnly([
          'adSoyad',
          'kullaniciAdi',
          'kullaniciAdiKucuk',
          'photoUrl',
          'avatarKey',
          'hesapGizli',
          'cocukHesabi',
          // Eski kayıtlardan PII temizliği (FieldValue.delete)
          'email',
          'dogumTarihi'
        ])
        // Public belgeye yeni e-posta / doğum tarihi eklenemez; silinebilir.
        && (!('email' in request.resource.data) || ('email' in resource.data))
        && (!('dogumTarihi' in request.resource.data) || ('dogumTarihi' in resource.data))
        && yasBayrakUyumlu()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isModerator', 'raporNedeniyleGizli', 'aramaSkoru', 'uid', 'puan', 'robot']);
    }

    function haftalikGorevUpdateOk() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let yeni = request.resource.data.haftalikGorev;
      return diff.hasOnly(['haftalikGorev'])
        && robotSeviyeFrom(resource.data) >= 11
        && yeni is map
        && yeni.hafta is string
        && yeni.gunTarih is string
        && yeni.puan is number
        && yeni.puan >= 0
        && yeni.puan <= 1000
        && yeni.sayac is map
        && yeni.tamamlanan is list
        && yeni.gunBonusuAlindi is bool;
    }

    function haftaVil(puan) {
      return puan == 1000 ? 300
          : puan >= 900 ? 200
          : puan >= 800 ? 100
          : puan > 0 ? 50
          : 0;
    }

    function haftaKapanisOdulOk() {
      return resource.data.get('haftalikGorev', null) is map
        && request.resource.data.get('haftalikGorev', null) is map
        && haftaKapanisOdulGovde();
    }

    function haftaKapanisOdulGovde() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let eski = resource.data.haftalikGorev;
      let yeni = request.resource.data.haftalikGorev;
      let puan = eski.puan;
      return puan is number
        && eski.hafta is string
        && eski.hafta.size() > 0
        && eski.hafta != yeni.hafta
        && yeni.puan == 0
        && robotSeviyeFrom(resource.data) >= 11
        && request.resource.data.sonOdulHafta == eski.hafta
        && diff.hasOnly([
          'haftalikGorev',
          'sonOdulHafta',
          'robot',
          'rozetAltin',
          'rozetGumus',
          'rozetBronz',
          'sonTacHafta',
          'tacAltin',
          'tacGumus',
          'tacBronz'
        ])
        && (
          (haftaVil(puan) == 0 && !diff.hasAny(['robot']))
          || (haftaVil(puan) > 0
              && resource.data.get('robot', null) is map
              && request.resource.data.robot.etkilesimPuani
                  == resource.data.robot.etkilesimPuani + haftaVil(puan)
              && robotSeviyeFrom(request.resource.data)
                  == robotSeviyeFrom(resource.data))
        )
        && (!diff.hasAny(['tacAltin']) || intChangedBy('tacAltin', 1))
        && (!diff.hasAny(['tacGumus']) || intChangedBy('tacGumus', 1))
        && (!diff.hasAny(['tacBronz']) || intChangedBy('tacBronz', 1))
        && !(diff.hasAny(['tacAltin']) && diff.hasAny(['tacGumus']))
        && !(diff.hasAny(['tacAltin']) && diff.hasAny(['tacBronz']))
        && !(diff.hasAny(['tacGumus']) && diff.hasAny(['tacBronz']))
        && (!diff.hasAny(['rozetAltin'])
            || (puan == 1000 && intChangedBy('rozetAltin', 1)))
        && (!diff.hasAny(['rozetGumus'])
            || (puan >= 900 && puan < 1000 && intChangedBy('rozetGumus', 1)))
        && (!diff.hasAny(['rozetBronz'])
            || (puan >= 800 && puan < 900 && intChangedBy('rozetBronz', 1)))
        && (!diff.hasAny(['sonTacHafta'])
            || request.resource.data.sonTacHafta == eski.hafta);
    }

    // -------------------------------------------------------------------------
    // Puan / sayaç anti-hile (transaction ile birlikte çalışır)
    // -------------------------------------------------------------------------

    // Beğeni geri çekme / yorum silme geri alımı; ownerScoreUpdateOk sonunda
    // 1000 ifade limitine takılıyordu. Anahtar kontrolü ucuz tutar.
    function ownerSosyalGeriAlimOk(userId) {
      let degisen = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(userId)
        && (
          (degisen.hasAny(['begeniSayisi'])
            && intChangedBy('begeniSayisi', -1)
            && ownerBegeniUnlikeSyncOk(userId))
          || (degisen.hasAny(['yorumSayisi'])
            && intChangedBy('yorumSayisi', -1)
            && degisen.hasOnly(['puan', 'yorumSayisi', 'sonYorumPuanPostId', 'sonYorumPuanCommentId', 'robot'])
            && (
              (changedOnly(['puan', 'yorumSayisi', 'sonYorumPuanPostId', 'sonYorumPuanCommentId'])
                && intChangedBy('puan', -3)
                && yorumSilOdulGeriAlOk(userId)
                && robotSeviyeFrom(resource.data) < 6)
              || (changedOnly(['yorumSayisi', 'sonYorumPuanPostId', 'sonYorumPuanCommentId'])
                && yorumSilOdulGeriAlOk(userId)
                && robotSeviyeFrom(resource.data) < 6)
              || (degisen.hasAny(['robot'])
                && (intChangedBy('puan', -3) || !degisen.hasAny(['puan']))
                && yorumSilOdulGeriAlOk(userId)
                && sosyalVilHarcaniyor(2))
            ))
        );
    }

    function ownerBegeniUnlikeSyncOk(userId) {
      let postId = request.resource.data.sonBegeniPuanPostId;
      return postId is string
        && postId.size() > 0
        && userCountersNonNegative()
        && !begeniKaydiVar(postId)
        && !exists(/databases/$(database)/documents/users/$(userId)/likedPosts/$(postId))
        && (
          (isOwner(userId)
            && changedOnly(['puan', 'begeniSayisi', 'sonBegeniPuanPostId'])
            && intChangedBy('puan', -2)
            && intChangedBy('begeniSayisi', -1))
          || (isOwner(userId)
            && changedOnly(['begeniSayisi', 'sonBegeniPuanPostId'])
            && intChangedBy('begeniSayisi', -1))
          || (isOwner(userId)
            && changedOnly(['puan', 'begeniSayisi', 'sonBegeniPuanPostId', 'robot'])
            && intChangedBy('puan', -2)
            && intChangedBy('begeniSayisi', -1)
            && sosyalVilHarcaniyor(2))
          || (isOwner(userId)
            && changedOnly(['begeniSayisi', 'sonBegeniPuanPostId', 'robot'])
            && intChangedBy('begeniSayisi', -1)
            && sosyalVilHarcaniyor(2))
        );
    }

    function ownerYemekKisaOk(userId) {
      return isOwner(userId)
        && changedOnly(['robot'])
        && ownerVilHarcamaliYemekOk();
    }

    function ownerGonderiSayacOk(userId) {
      let postId = request.resource.data.sonGonderiPuanPostId;
      return isOwner(userId)
        && changedOnly(['puan', 'gonderiSayisi', 'sonGonderiPuanPostId'])
        && userCountersNonNegative()
        && intChangedBy('puan', 10)
        && intChangedBy('gonderiSayisi', 1)
        && postId is string
        && postId.size() > 0
        && !exists(/databases/$(database)/documents/posts/$(postId))
        && getAfter(/databases/$(database)/documents/posts/$(postId)).data.userId == userId;
    }

